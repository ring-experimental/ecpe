/* 필드 메뉴 틀(restored/fm_shell.c, ui/README.md '필드 메뉴 틀'). 틀 문서(fm_shell.rml)와 필드 메뉴 화면 문서들이 같이 쓴다.
   틀은 모드 1(필드에서 연 일반 메뉴)의 화면 0~7에 늘 같은 자리에 있다: 왼쪽 레일, 캐릭터 화면 위의 캐릭터 띠, 아래 고정 버튼 띠.
   화면 문서는 body.shell이면 .screen을 내용 자리(레일 오른쪽, 띠 사이)로 옮긴다. 자리(568×320, 여백 10/14):
     레일 x 14~124 / 내용 x 132~554 / 캐릭터 띠 y 10~40(캐릭터 화면만) / 버튼 띠 아래 10dp, 높이 30dp.
   좁은 화면(폭 400 미만, .narrow): 레일은 아이콘만(폭 30), 여백 6. */

/* ---- 화면 문서: 내용 자리 ---- */
/* .fmarea: 틀 안에 뜨는 자체 창(강화·귀환·망각의 물약·상점 결과 카드)의 막. 화면 전체가 아니라 내용 자리만 덮어 레일·캐릭터 띠·버튼 띠가 늘 눌린다 */
body.shell .screen, body.shell .fmarea { position: absolute; left: 132dp; right: 14dp; top: 10dp; bottom: 44dp; width: auto; height: auto; padding: 0; }
body.shell.chars .screen, body.shell.chars .fmarea { top: 44dp; }
body.shell.narrow .screen, body.shell.narrow .fmarea { left: 40dp; right: 6dp; top: 6dp; bottom: 38dp; padding: 0; }
body.shell.narrow.chars .screen, body.shell.narrow.chars .fmarea { top: 36dp; }

/* ---- 고정 버튼 띠(<fmbar/>, host/ui_vlist.cpp가 펼친다) ----
   오른쪽 끝 「이전」, 그 왼쪽 「결정」은 폭이 고정이라 어떤 상태에서도 자리·크기가 같다. 쓸 수 없으면 사라지지 않고 흐려진다. */
.fmbar { position: absolute; left: 132dp; right: 14dp; bottom: 10dp; height: 30dp; display: flex; flex-direction: row; align-items: center;
         box-sizing: border-box; padding: 0 3dp; background-color: #10143290; border: 1dp #4a5296; border-radius: 3dp; }
body.narrow .fmbar { left: 40dp; right: 6dp; bottom: 6dp; }
.fbex { flex: 1 1 0; min-width: 0; display: flex; flex-direction: row; overflow: hidden; }
.fbw { flex: 0 0 auto; margin-right: 3dp; }
.fbw.hid { display: none; }
.fbw.fok, .fbw.fback { flex: 0 0 84dp; width: 84dp; margin: 0 0 0 3dp; }
body.narrow .fbw.fok, body.narrow .fbw.fback { flex: 0 0 60dp; width: 60dp; }
.fb { display: flex; flex-direction: row; justify-content: center; align-items: center; height: 24dp; padding: 0 6dp; box-sizing: border-box;
      white-space: nowrap; overflow: hidden; color: #fff; background-color: #2a3470; border: 1dp #8c96e8; border-radius: 3dp; }
body.narrow .fb { padding: 0 5dp; }
.fok .fb { decorator: horizontal-gradient(#3f78f0 #2a4ab8); border-color: #a8c4ff; }
.fb.off, .fok .fb.off { color: #6c74a0; background-color: #161a3e; border-color: #3a4280; decorator: none; }
.fb.hover { background-color: #3a46a0; border-color: #ffffce; }
.fok .fb.hover { decorator: horizontal-gradient(#5a90ff #3a5ad8); border-color: #ffffce; }
.fb.press { background-color: #3f78f0; }
/* 키 이름표(키보드·패드에서만): 버튼 안 오른쪽에 작게 "| Enter" */
.fbk { margin-left: 4dp; padding-left: 4dp; border-left: 1dp #8c96e8; font-size: 10dp; line-height: 12dp; color: #cfd3ff; }
.fb.off .fbk { color: #6c74a0; border-left-color: #3a4280; }
body.touch .fbk { display: none; }
/* 좁은 화면(폭 400 미만)은 「결정」「이전」이 60dp라 키 이름표까지는 들어가지 않는다(이름만) */
body.narrow .fbk { display: none; }

/* ---- 틀 문서(fm_shell.rml) ---- */
#rail { position: absolute; left: 14dp; top: 10dp; bottom: 10dp; width: 110dp; display: flex; flex-direction: column; padding: 4dp; }
body.narrow #rail { left: 6dp; top: 6dp; bottom: 6dp; width: 30dp; padding: 2dp; }
.rrow { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; height: 24dp; padding: 0 5dp; margin-bottom: 2dp; box-sizing: border-box;
        white-space: nowrap; overflow: hidden; color: #c8cdf6; background-color: #10143270; border: 1dp #00000000; border-radius: 3dp; }
body.narrow .rrow { padding: 0; justify-content: center; }
.rrow .ric { flex: 0 0 18dp; width: 18dp; height: 16dp; margin-right: 4dp; display: flex; justify-content: center; align-items: center; }
body.narrow .rrow .ric { margin-right: 0; }
.rrow .rnm { flex: 1 1 0; min-width: 0; overflow: hidden; }
body.narrow .rrow .rnm { display: none; }
.rrow.hover { background-color: #2a3470; border-color: #8c96e8; }
/* 지금 열린 화면(금색 테두리), 홈의 키보드 커서 줄(파란 띠) */
.rrow.cur { color: #fff; background-color: #3a2e70; border-color: #f2c84a; }
.rrow.sel { color: #fff; decorator: horizontal-gradient(#3f78f0 #2a4ab8); border-color: #a8c4ff; }
#rail.lock .rrow { opacity: 0.4; }
.rgap { flex: 1 1 0; min-height: 4dp; }
#rinfo h2 { margin-top: 3dp; }
#rinfo .rv { text-align: right; height: 14dp; }
#rinfo .place { color: #fff; font-size: 10dp; line-height: 12dp; }
body.narrow #rinfo { display: none; }

/* 캐릭터 띠(스킬·장비·스테이터스 위): 칩(작은 초상 + 이름 + LV), 지금 캐릭터 강조, 양 끝 ◀▶ */
#chips { position: absolute; left: 132dp; right: 14dp; top: 10dp; height: 30dp; display: flex; flex-direction: row; align-items: center; }
body.narrow #chips { left: 40dp; right: 6dp; top: 6dp; height: 26dp; }
#chips.lock { opacity: 0.4; }
.carr { flex: 0 0 24dp; width: 24dp; height: 28dp; line-height: 28dp; text-align: center; color: #ffd75e; background-color: #1c2450; border: 1dp #4a5296; border-radius: 3dp; box-sizing: border-box; }
body.narrow .carr { height: 26dp; line-height: 26dp; }
.carr.hover { background-color: #2a3470; border-color: #ffffce; }
.chipbox { flex: 1 1 0; min-width: 0; display: flex; flex-direction: row; margin: 0 3dp; }
.chip { flex: 1 1 0; min-width: 0; max-width: 120dp; height: 28dp; display: flex; flex-direction: row; align-items: center; margin-right: 3dp; padding: 0 4dp 0 1dp;
        box-sizing: border-box; background-color: #10143290; border: 1dp #4a5296; border-radius: 3dp; white-space: nowrap; overflow: hidden; }
.chip.off { display: none; }
.chip.sel { decorator: horizontal-gradient(#3f78f0c0 #2a4ab8c0); border-color: #f2c84a; }
.chip.hover { border-color: #ffffce; }
.chip .cf { flex: 0 0 24dp; width: 24dp; height: 23dp; margin-right: 4dp; overflow: hidden; }
.chip .ct { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }
.chip .cn { display: block; overflow: hidden; font-size: 10dp; line-height: 12dp; color: #fff; }
.chip .cl { display: block; font-size: 10dp; line-height: 11dp; color: #9aa2d8; }
body.narrow .chip { height: 26dp; flex: 0 0 28dp; width: 28dp; padding: 0 1dp; justify-content: center; }
body.narrow .chip .ct { display: none; }
body.narrow .chip .cf { margin-right: 0; }

/* 키 안내(게임패드·키보드): 레일 넘기기(LB/RB, Tab), 캐릭터 넘기기(LT/RT, [ ]). 터치와 좁은 화면에서는 감춘다 */
.rhint { flex: 0 0 auto; margin-top: 3dp; text-align: center; font-size: 10dp; line-height: 14dp; color: #9aa2d8; white-space: nowrap; }
.rhint .key { margin: 0 2dp 0 0; font-size: 10dp; }
.rhint .rht { margin-left: 2dp; }
body.touch .rhint, body.narrow .rhint { display: none; }
.carr .chk { font-size: 10dp; color: #cfd3ff; margin: 0 2dp; }
body.pad .carr { flex-basis: 40dp; width: 40dp; }
body.touch .carr .chk, body.narrow .carr .chk { display: none; }
body.pad.narrow .carr { flex-basis: 24dp; width: 24dp; }
/* 버튼 띠의 방향 키 안내(fm_bar_hint): 보조 버튼과 「결정」 사이 오른쪽 끝. 키보드·게임패드에서만 */
.fbh { flex: 1 1 0; min-width: 0; margin: 0 6dp; text-align: right; font-size: 10dp; line-height: 24dp; color: #aab4ff; white-space: nowrap; overflow: hidden; }
body.touch .fbh, body.narrow .fbh { display: none; }
