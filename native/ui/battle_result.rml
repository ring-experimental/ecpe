<rml><head><link type="text/rcss" href="base.rcss"/>
<!-- 전투 결과. 원작은 쪽마다 작은 창을 늘어놓았다(쪽 0 골드·EXP·LV UP, 쪽 1 스킬 획득, 쪽 2 드롭).
     여기서는 가운데 카드 하나에 지금 쪽을 보이고, 쪽 표시를 단다. -->
<style>
body div.off { display: none; }
/* 맨 앞의 .tapall이 눌리도록, 전체를 덮는 .screen은 누름을 통과시킨다(뒤에 놓인 것이 가려지지 않게) */
.screen { pointer-events: none; }
#card { width: 220dp; }
.mr { display: flex; flex-direction: row; align-items: center; height: 16dp; white-space: nowrap; }
.mr .nm { flex: 1 1 0; }
.mr .ex { color: #fff; margin-left: 6dp; }
.lv { margin-left: 6dp; padding: 0 4dp; font-size: 10dp; line-height: 12dp; color: #1a1050; background-color: #ffd75e; border-radius: 2dp; }
.ko { color: #ff7a7a; font-size: 10dp; margin-left: 4dp; }
.gl { display: flex; flex-direction: row; align-items: center; height: 18dp; }
.dots { text-align: center; margin-top: 4dp; }
.dot { color: #4a5296; margin: 0 2dp; }
.dot.on { color: #ffd75e; }
.dr { display: flex; flex-direction: row; align-items: center; height: 18dp; }
.dr img { margin-right: 6dp; }
</style></head>
<body data-model="battle_result">
<div class="tapall" key="ok"></div>
<div class="screen dim-soft center fade">
  <div id="card" class="panel gold pop">
    <div class="title">전투 결과<span class="sub">{{d.page + 1}}/3</span></div>
    <div data-if="d.page == 0">
      <div class="gl"><span class="label">골드</span><span class="gold" style="margin-left: 8dp;">{{d.gold}} G</span></div>
      <div class="sep"></div>
      <div class="mr" data-for="m : d.members" data-class-off="!m.v"><span class="nm">{{m.name}}</span><span class="ko" data-if="m.ko">전투불능</span><span class="label">EXP</span><span class="ex">{{m.exp}}</span><span class="lv" data-if="m.lvup">LV UP</span></div>
    </div>
    <div data-if="d.page == 1">
      <h2>스킬 획득</h2>
      <div class="mr" data-for="s : d.skills" data-class-off="!s.v"><span class="gold">{{s.t}}</span></div>
    </div>
    <div data-if="d.page == 2">
      <h2>얻은 아이템</h2>
      <div class="dr" data-for="it : d.drops" data-class-off="!it.v"><img data-if="it.icon != ''" data-attr-src="it.icon"/><span>{{it.name}}</span></div>
    </div>
    <div class="dots"><span class="dot" data-class-on="d.page == 0">●</span><span class="dot" data-class-on="d.page == 1">●</span><span class="dot" data-class-on="d.page == 2">●</span></div>
    <div class="keys mid"><span class="kb" key="ok"><span class="key">{{'ok' | key}}</span>계속</span></div>
  </div>
</div>
</body></rml>
